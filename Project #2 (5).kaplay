{"name":"Project #2","version":"2.0.0","files":[["main.js",{"path":"main.js","kind":"main","value":"// 8) The entry point KAPLAYGROUND actually runs. Your project uses real\n//    modules, not \"Legacy Build Mode\" - each file is its own scope, so\n//    anything one file needs from another (including KAPLAY's own API,\n//    see kaplay.js) has to be import/export'ed explicitly.\n//\n// scenes/game.js transitively imports level.js, enemies.js, player.js and\n// utils/raycast.js already, so importing it here is enough to pull in the\n// whole dependency graph - but the extra explicit imports below are cheap\n// and harmless (ES modules cache each file, so nothing runs twice), and\n// they make the load order obvious at a glance if you're debugging.\n\nimport k from \"./kaplay.js\";\nimport \"./utils/raycast.js\";\nimport \"./objects/level.js\";\nimport \"./objects/enemies.js\";\nimport \"./objects/player.js\";\nimport \"./scenes/game.js\";\nimport \"./scenes/room2.js\";\nimport \"./scenes/title.js\";\nimport \"./scenes/options.js\";\n\nconst { go } = k;\n\ngo(\"title\");\n","language":"javascript"}],["assets.js",{"path":"assets.js","kind":"assets","value":"// 2) Runs second: loads/generates every sprite the game needs.\n//\n// These textures are generated procedurally on a <canvas> and loaded as\n// data URLs, so the project works without uploading any image files. If you\n// want real art instead, upload PNGs in the Sprites tab and swap the\n// loadSprite(...) lines below to loadSprite(\"wall\", \"assets/sprites/wall.png\")\n// etc. - everything else (wallSlices/enemySlices) keeps working unchanged.\n//\n// This project uses real ES modules (your KAPLAYGROUND project runs each\n// file as its own module, not a merged \"Legacy Build Mode\" script) - so\n// anything another file needs has to be `export`ed here and `import`ed\n// there explicitly. wallTex/wallSlices/enemyTex/enemySlices are exported as\n// `let` bindings; ES module imports are \"live\", so objects/player.js will\n// see the real values once onLoad() below fires and reassigns them, even\n// though it imported them before that happened.\n//\n// loadSprite/onLoad/getSprite/Quad come from the object kaplay() returns\n// (see kaplay.js) - they're not ambient globals here, so we import them.\n\nimport k from \"./kaplay.js\";\nconst { loadSprite, onLoad, getSprite, Quad } = k;\n\nfunction makeDataURL(w, h, draw) {\n    const c = document.createElement(\"canvas\");\n    c.width = w;\n    c.height = h;\n    draw(c.getContext(\"2d\"), w, h);\n    return c.toDataURL();\n}\n\nconst wallDataURL = makeDataURL(32, 32, (ctx, w, h) => {\n    ctx.fillStyle = \"#7a3b2e\";\n    ctx.fillRect(0, 0, w, h);\n    ctx.strokeStyle = \"#4a2018\";\n    ctx.lineWidth = 1;\n    const rows = 4;\n    for (let row = 0; row < rows; row++) {\n        const y = row * (h / rows);\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(w, y);\n        ctx.stroke();\n        const offset = row % 2 === 0 ? 0 : w / 4;\n        for (let col = -1; col < 5; col++) {\n            const x = col * (w / 4) + offset;\n            ctx.beginPath();\n            ctx.moveTo(x, y);\n            ctx.lineTo(x, y + h / rows);\n            ctx.stroke();\n        }\n    }\n});\n\nconst enemyDataURL = makeDataURL(24, 24, (ctx, w, h) => {\n    ctx.fillStyle = \"#2e8b57\";\n    ctx.beginPath();\n    ctx.ellipse(w / 2, h / 2 + 2, w / 2 - 2, h / 2 - 1, 0, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.fillStyle = \"white\";\n    ctx.beginPath();\n    ctx.ellipse(w / 2 - 5, h / 2 - 2, 3, 4, 0, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.beginPath();\n    ctx.ellipse(w / 2 + 5, h / 2 - 2, 3, 4, 0, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.fillStyle = \"black\";\n    ctx.beginPath();\n    ctx.arc(w / 2 - 5, h / 2 - 2, 1.5, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.beginPath();\n    ctx.arc(w / 2 + 5, h / 2 - 2, 1.5, 0, Math.PI * 2);\n    ctx.fill();\n});\n\nconst gunDataURL = makeDataURL(48, 32, (ctx, w, h) => {\n    ctx.fillStyle = \"#333\";\n    ctx.fillRect(w * 0.3, 0, w * 0.18, h * 0.6);\n    ctx.fillStyle = \"#555\";\n    ctx.fillRect(w * 0.15, h * 0.55, w * 0.5, h * 0.25);\n    ctx.fillStyle = \"#222\";\n    ctx.fillRect(w * 0.2, h * 0.75, w * 0.15, h * 0.25);\n});\n\n// NOTE: to switch any of these over to a real uploaded PNG (e.g. the\n// wall.png already sitting in the Sprites tab), just replace the data-URL\n// argument below with the file name, e.g.:\n//   loadSprite(\"wall\", \"sprites/wall.png\");\n// wallSlices/enemySlices (built in onLoad() below) work identically either\n// way, since they're built from whatever getSprite(\"wall\")/getSprite(\"enemy\")\n// resolves to.\nloadSprite(\"wall\", wallDataURL);\nloadSprite(\"enemy\", enemyDataURL);\nloadSprite(\"gun\", gunDataURL);\n\n// Slices used to render textured vertical strips during raycasting.\nexport let wallTex;\nexport let wallSlices = [];\nexport let enemyTex;\nexport let enemySlices = [];\n\nonLoad(() => {\n    wallTex = getSprite(\"wall\").data;\n    for (let i = 0; i < wallTex.width; i++) {\n        // NOTE: the original demo did\n        // wallTex.frames[0].q.scale(new Quad(i / wallTex.width, 0, 1 / wallTex.width, 1))\n        // \".scale()\" on a Quad composes it with the parent frame's own UV\n        // rect. For a single-frame sprite (no sprite-sheet packing, which is\n        // the case here) that parent rect is always (0,0,1,1), so composing\n        // with it is a no-op - we can build the slice Quad directly instead.\n        // This also sidesteps any Quad.scale() API differences between\n        // KAPLAY versions, which is likely what \"scale is not defined\" was\n        // coming from.\n        wallSlices.push(new Quad(i / wallTex.width, 0, 1 / wallTex.width, 1));\n    }\n\n    enemyTex = getSprite(\"enemy\").data;\n    for (let i = 0; i < enemyTex.width; i++) {\n        enemySlices.push(new Quad(i / enemyTex.width, 0, 1 / enemyTex.width, 1));\n    }\n});\n","language":"javascript"}],["kaplay.js",{"path":"kaplay.js","kind":"kaplay","value":"// 1) Must run before anything else touches KAPLAY's API.\n//\n// Your `kaplay()` initializer itself is ambient (calling it bare here works\n// fine) - but its RETURN VALUE, the object holding every function you\n// actually use (vec2, add, loadSprite, onKeyDown, scene, go, ...), is NOT\n// automatically spread onto globals in your project. That's what caused\n// \"loadSprite is not defined\": assets.js called loadSprite(...) as a bare\n// global, but it only exists on the object kaplay() returns.\n//\n// So: capture that object here and export it. Every other file imports it\n// as `k` and destructures exactly the pieces it uses, e.g.:\n//   import k from \"../kaplay.js\";\n//   const { vec2, add } = k;\n\nconst k = kaplay({\n    width: 1280,\n    height: 720,\n    scale: 1,\n    background: [135, 62, 132],\n});\nexport default k;\n","language":"javascript"}],["scenes/game.js",{"path":"scenes/game.js","kind":"scene","value":"// 7) Registers the \"game\" scene - imported (for its side effect) by\n//    main.js. Defining a scene here doesn't run any of this code yet -\n//    scene() just registers it. main.js calls go(\"game\") to actually\n//    start it.\n//\n// Restarting the level is simply calling go(\"game\") again: KAPLAY destroys\n// every object added by the previous scene run automatically, and this\n// callback re-runs buildLevel()/spawnEnemies()/createCamera() from\n// scratch, so there's no manual state-reset code needed anywhere.\n\nimport k from \"../kaplay.js\";\nconst {\n    scene, go, Vec2, vec2, dt, debug,\n    onKeyDown, onKeyPress, onUpdate, onTouchStart, onTouchMove,\n    // onClick is the long-standing stable name; onMousePress/onMouseDown\n    // are tried as fallbacks below in case your KAPLAY version names it\n    // differently. Destructuring a name that doesn't exist on `k` just\n    // gives `undefined` here, it doesn't throw - the typeof guard below\n    // handles picking whichever one is actually a function.\n    onClick, onMousePress, onMouseDown,\n} = k;\nimport { buildLevel, grid, generateLevel, isLavaAt } from \"../objects/level.js\";\nimport { spawnEnemies, updateEnemies, ENEMY_SPAWNS, setEnemySpawns, enemies } from \"../objects/enemies.js\";\nimport { createCamera } from \"../objects/player.js\";\nimport { resetProjectiles, updateProjectiles } from \"../objects/projectiles.js\";\nimport { setItemSpawns, spawnItems, updateItems } from \"../objects/items.js\";\nimport { advanceFloor, resetRun, won, persistentWeapons, persistentHp, setPersistentHp } from \"../objects/progress.js\";\nimport { rayCastAsciiGrid } from \"../utils/raycast.js\";\nconst LAVA_DPS = 20;\n\nscene(\"game\", () => {\n    const generated = generateLevel();\n    setEnemySpawns(generated.enemySpawns);\n    buildLevel();\n    spawnEnemies();\n    // Crystal chests - the floor-progress goal (see objects/progress.js) -\n    // are placed by generateLevel() itself, alongside the melee/lava-arena\n    // enemy rooms, so they always land in otherwise-empty rooms.\n    setItemSpawns(generated.crystalSpawns.map((pos) => ({ pos, item: \"crystal\" })));\n    spawnItems();\n    resetProjectiles();\n    const camera = createCamera();\n    // Weapons/HP carry over between floors of the same run (reset together\n    // by resetRun() - see objects/progress.js) - a brand new camera is\n    // created on every go(\"game\"), including floor transitions.\n    camera.weapons.sword = persistentWeapons.sword;\n    camera.weapons.gun = persistentWeapons.gun;\n    if (camera.weapons.gun) camera.currentWeapon = \"gun\";\n    camera.hp = persistentHp;\n\n    function shoot() {\n        if (camera.currentWeapon !== \"gun\" || camera.shootCooldown > 0 || camera.gameOver || camera.wonRun || camera.score >= ENEMY_SPAWNS.length) {\n            return;\n        }\n        camera.shootCooldown = 0.35;\n        camera.muzzleFlash = 0.15;\n\n        const dir = Vec2.fromAngle(camera.angle).scale(16 * 20); // ~20 tiles range\n        const result = rayCastAsciiGrid(camera.pos, dir, grid);\n\n        let closest = null;\n        for (const o of result.objects) {\n            if (!o.enemy) continue; // ignore projectile/item billboards - only enemies take gun damage\n            if (!closest || o.t < closest.t) closest = o;\n        }\n\n        if (closest && closest.t < result.t) {\n            const e = closest.enemy;\n            e.hp -= 40;\n            e.hitFlash = 0.15;\n            if (e.hp <= 0 && !e.dead) {\n                e.dead = true;\n                e.marker.opacity = 0.15; // faint corpse marker on the minimap\n                camera.score++;\n            }\n        }\n    }\n\n    // ---- Sword (melee weapon) ----\n    // Short-range, cone-in-front-of-player attack: hits the closest living\n    // enemy within SWORD_RANGE whose direction from the player is within\n    // roughly a 60-degree cone of the camera's facing direction.\n    const SWORD_RANGE = 40;\n    const SWORD_DAMAGE = 60;\n    const SWORD_CONE_DOT = 0.5; // cos(60deg) - facingDir . toEnemyDir must exceed this\n\n    function meleeAttack() {\n        if (camera.currentWeapon !== \"sword\" || camera.swordCooldown > 0 || camera.gameOver || camera.wonRun || camera.score >= ENEMY_SPAWNS.length) {\n            return;\n        }\n        camera.swordCooldown = 0.45;\n        camera.swordSwing = 0.2;\n\n        const facing = Vec2.fromAngle(camera.angle);\n        let target = null;\n        let targetDist = Infinity;\n\n        for (const e of enemies) {\n            if (e.dead) continue;\n            const toEnemy = e.pos.sub(camera.pos);\n            const dist = toEnemy.len();\n            if (dist > SWORD_RANGE) continue;\n            const facingDot = dist > 0 ? facing.dot(toEnemy.scale(1 / dist)) : 1;\n            if (facingDot < SWORD_CONE_DOT) continue;\n            if (dist < targetDist) {\n                targetDist = dist;\n                target = e;\n            }\n        }\n\n        if (target) {\n            target.hp -= SWORD_DAMAGE;\n            target.hitFlash = 0.15;\n            if (target.hp <= 0 && !target.dead) {\n                target.dead = true;\n                target.marker.opacity = 0.15;\n                camera.score++;\n            }\n        }\n    }\n\n    // Mouse-click-to-shoot: KAPLAY versions differ a bit on the exact global\n    // mouse-input function name, so we try the common ones instead of\n    // hard-crashing if one isn't available in your build. Space always works\n    // regardless.\n    if (typeof onClick === \"function\") {\n        onClick(() => shoot());\n    }\n    else if (typeof onMousePress === \"function\") {\n        onMousePress(() => shoot());\n    }\n    else if (typeof onMouseDown === \"function\") {\n        onMouseDown(() => shoot());\n    }\n\n    onKeyPress(\"space\", () => shoot());\n    onKeyPress(\"e\", () => meleeAttack());\n    onKeyPress(\"n\", () => go(\"room2\")); // warp to the new purple-shooter room\n    onKeyPress(\"1\", () => { camera.currentWeapon = \"sword\"; }); // equip sword\n    onKeyPress(\"2\", () => { if (camera.weapons.gun) camera.currentWeapon = \"gun\"; }); // equip gun (if owned)\n    onKeyPress(\"enter\", () => {\n        if (camera.gameOver || camera.wonRun || camera.score >= ENEMY_SPAWNS.length) {\n            resetRun();\n            go(\"game\");\n        }\n    });\n\n    // ---- Movement ----\n\n    onKeyDown(\"w\", () => {\n        camera.move(Vec2.fromAngle(camera.angle).scale(40));\n    });\n\n    onKeyDown(\"s\", () => {\n        camera.move(Vec2.fromAngle(camera.angle).scale(-40));\n    });\n    onKeyDown(\"a\", () => {\n        camera.move(Vec2.fromAngle(camera.angle - 90).scale(40));\n    });\n    onKeyDown(\"d\", () => {\n        camera.move(Vec2.fromAngle(camera.angle + 90).scale(40));\n    });\n\n    onKeyDown(\"left\", () => {\n        camera.angle -= 90 * dt();\n    });\n\n    onKeyDown(\"right\", () => {\n        camera.angle += 90 * dt();\n    });\n\n    // Debug keys carried over from the original demo.\n    onKeyDown(\"f\", () => {\n        camera.focalLength = Math.max(1, camera.focalLength - 10 * dt());\n    });\n\n    onKeyDown(\"g\", () => {\n        camera.focalLength += 10 * dt();\n    });\n\n    onKeyDown(\"r\", () => {\n        camera.fov = Math.max(1, camera.fov - 10 * dt());\n    });\n\n    onKeyDown(\"t\", () => {\n        camera.fov += 10 * dt();\n    });\n\n    onKeyDown(\"p\", () => {\n        debug.paused = !debug.paused;\n    });\n\n    let lastTouchPos = vec2();\n\n    onTouchStart(p => {\n        lastTouchPos = p;\n    });\n\n    onTouchMove(p => {\n        const delta = p.sub(lastTouchPos);\n        if (delta.x < 0) camera.angle -= 90 * dt();\n        else if (delta.x > 0) camera.angle += 90 * dt();\n        if (delta.y < 0) camera.move(Vec2.fromAngle(camera.angle).scale(40));\n        else if (delta.y > 0) camera.move(Vec2.fromAngle(camera.angle).scale(-40));\n        lastTouchPos = p;\n    });\n\n    // ---- Per-frame timers + enemy AI ----\n\n    onUpdate(() => {\n        if (camera.shootCooldown > 0) camera.shootCooldown -= dt();\n        if (camera.muzzleFlash > 0) camera.muzzleFlash -= dt();\n        if (camera.swordCooldown > 0) camera.swordCooldown -= dt();\n        if (camera.swordSwing > 0) camera.swordSwing -= dt();\n        if (camera.pickupMessageTimer > 0) camera.pickupMessageTimer -= dt();\n        if (camera.gameOver || camera.wonRun) return;\n\n        const damage = updateEnemies(camera.pos);\n        if (damage > 0) {\n            camera.hp -= damage;\n            if (camera.hp <= 0) {\n                camera.hp = 0;\n                camera.gameOver = true;\n            }\n        }\n        updateItems(camera.pos, camera);\n        if (camera.floorComplete) {\n            camera.floorComplete = false;\n            // Carry weapons/HP into the next floor's fresh camera (see the\n            // sync right after createCamera() above).\n            persistentWeapons.sword = camera.weapons.sword;\n            persistentWeapons.gun = camera.weapons.gun;\n            setPersistentHp(camera.hp);\n            advanceFloor();\n            if (won) {\n                camera.wonRun = true;\n            } else {\n                go(\"game\");\n            }\n        }\n        const projDamage = updateProjectiles(camera.pos);\n        if (projDamage > 0) {\n            camera.hp -= projDamage;\n            if (camera.hp <= 0) {\n                camera.hp = 0;\n                camera.gameOver = true;\n            }\n        }\n        if (isLavaAt(camera.pos) && !camera.gameOver) {\n            camera.hp -= LAVA_DPS * dt();\n            if (camera.hp <= 0) {\n                camera.hp = 0;\n                camera.gameOver = true;\n            }\n        }\n    });\n});\n","language":"javascript"}],["objects/player.js",{"kind":"obj","value":"import k from \"../kaplay.js\";\nconst {\n    add, pos, rotate, z, rect, anchor, area, opacity, body,\n    pushTransform, pushRotate, pushTranslate, popTransform, pushScale,\n    drawCircle, drawLine, drawRect, drawText,\n    vec2, Vec2, lerp, RED, BLACK, WHITE, rgb, \n} = k;\nimport { grid, playerSpawn } from \"./objects/level.js\";\nimport { rayCastAsciiGrid } from \"../utils/raycast.js\";\nimport { ENEMY_SPAWNS } from \"./objects/enemies.js\";\nimport { ITEM_TYPES } from \"./objects/items.js\";\nimport { currentFloor, crystalsCollected, CRYSTALS_PER_FLOOR, MAX_FLOORS } from \"./objects/progress.js\";\n\nconst ENEMY_COLOR = rgb(46, 139, 87);\nconst PROJECTILE_COLOR = rgb(160, 32, 240);\n\nexport function createCamera() {\n    return add([\n        pos(playerSpawn.x, playerSpawn.y),\n        rotate(0),\n        z(-1),\n        rect(8, 8),\n        anchor(\"center\"),\n        area(),\n        opacity(0),\n        body(),\n        {\n            draw() {\n                const screenW = k.width();\n                const screenH = k.height();\n\n                pushTransform();\n                pushRotate(-this.angle);\n\n\n                const dir = Vec2.fromAngle(this.angle);\n                const perp = dir.normal();\n\n                const planeP1 = this.pos\n                    .add(dir.scale(this.focalLength))\n                    .add(perp.scale(this.fov))\n                    .sub(this.pos);\n\n                const planeP2 = this.pos\n                    .add(dir.scale(this.focalLength))\n                    .sub(perp.scale(this.fov))\n                    .sub(this.pos);\n\n\n                pushTranslate(this.pos.scale(-1));\n\n                drawRect({\n                    width: screenW,\n                    height: screenH / 2,\n                    color: rgb(100, 100, 100),\n                });\n\n                drawRect({\n                    pos: vec2(0, screenH / 2),\n                    width: screenW,\n                    height: screenH / 2,\n                    color: rgb(128, 128, 128),\n                });\n\n                for (let x = 0; x < screenW; x++) {\n\n                    const direction = lerp(\n                        planeP1,\n                        planeP2,\n                        x / (screenW - 1)\n                    ).scale(6);\n\n                    const hit = rayCastAsciiGrid(this.pos, direction, grid);\n\n                    if (hit && hit.object) {\n\n                        const t = hit.t;\n                        const shade =\n                            (1 - t) *\n                            ((hit.normal.x + hit.normal.y) < 0 ? 0.5 : 1);\n\n                        const h = screenH / (t * direction.len() / 16);\n\n                        drawRect({\n                            width: 1,\n                            height: h,\n                            pos: vec2(\n                                x,\n                                screenH / 2 - h / 2\n                            ),\n                            color: (hit.object.color || WHITE)\n                                .lerp(BLACK, Math.max(0, 1 - shade)),\n                        });\n                    }\n\n                    if (hit.objects.length > 0) {\n\n                        hit.objects\n                            .sort((a, b) => b.t - a.t)\n\n                            .forEach(o => {\n\n                                if (hit.object && o.t > hit.t) return;\n\n                                const wh =\n                                    screenH /\n                                    (o.t * direction.len() / 16);\n\n                                const shade = 1 - o.t;\n\n                                if (o.projectile) {\n\n                                    const ph =\n                                        30 /\n                                        (o.t * direction.len() / 16);\n\n                                    drawRect({\n                                        width: 1,\n                                        height: ph,\n                                        pos: vec2(\n                                            x,\n                                            screenH / 2 + wh / 2 - ph\n                                        ),\n                                        color: PROJECTILE_COLOR\n                                            .lerp(BLACK, Math.max(0, 1 - shade)),\n                                    });\n\n                                    return;\n                                }\n\n                                if (o.item) {\n\n    // Larger crystal size\n    const crystalHeight =\n        400 /\n        (o.t * direction.len() / 16);\n\n\n    const crystalWidth =\n        crystalHeight * 0.20;\n\n\n    const crystalX = x;\n\n    const crystalY =\n        screenH / 2 + wh / 2 - crystalHeight;\n\n\n    // Main crystal body\n    drawRect({\n        width: 1,\n        height: crystalHeight,\n        pos: vec2(\n            crystalX,\n            crystalY\n        ),\n        color: rgb(80, 220, 255)\n            .lerp(BLACK, Math.max(0, 1 - shade)),\n    });\n\n\n    // Crystal bright core\n    if (o.s > 0.35 && o.s < 0.65) {\n\n        drawRect({\n            width: 1,\n            height: crystalHeight * 0.75,\n            pos: vec2(\n                crystalX,\n                crystalY + crystalHeight * 0.12\n            ),\n            color: rgb(180, 255, 255)\n                .lerp(BLACK, Math.max(0, 1 - shade)),\n        });\n\n\n        // Crystal dark facet\n        drawRect({\n            width: 1,\n            height: crystalHeight * 0.45,\n            pos: vec2(\n                crystalX + crystalWidth * 0.25,\n                crystalY + crystalHeight * 0.30\n            ),\n            color: rgb(40, 140, 220)\n                .lerp(BLACK, Math.max(0, 1 - shade)),\n        });\n\n\n        // Crystal shine\n        drawRect({\n            width: 1,\n            height: crystalHeight * 0.18,\n            pos: vec2(\n                crystalX - crystalWidth * 0.15,\n                crystalY + crystalHeight * 0.15\n            ),\n            color: WHITE\n                .lerp(BLACK, Math.max(0, 1 - shade)),\n        });\n    }\n\n\n    return;\n}\n\n                                const enemyHeight =\n    600 /\n    (o.t * direction.len() / 16);\n// Enemy body (slimmer)\n\nconst enemyTop =\n    screenH / 2 + wh / 2 - enemyHeight;\n\n\n// slimmer body width reference\nconst enemyWidth =\n    enemyHeight * 0.45;\n\n\n// body slice\ndrawRect({\n    width: 1,\n    height: enemyHeight,\n    pos: vec2(\n        x,\n        enemyTop\n    ),\n    color: ENEMY_COLOR\n        .lerp(BLACK, Math.max(0, 1 - shade)),\n});\n\n\n// ==========================\n// Enemy face (larger)\n// ==========================\n\nif (o.enemy) {\n\n    // draw face only at billboard center\n    if (o.s > 0.45 && o.s < 0.55) {\n\n        const faceX = x;\n\n        const faceY =\n            enemyTop +\n            enemyHeight * 0.16;\n\n\n        // Bigger eyes\n        const eyeSize =\n            enemyHeight * 0.13;\n\n\n        const eyeY = faceY;\n\n\n        // Wider eye spacing\n        const eyeOffset =\n            enemyWidth * 0.24;\n\n\n        // LEFT EYE WHITE\n        drawRect({\n            pos: vec2(\n                faceX - eyeOffset,\n                eyeY\n            ),\n            width: eyeSize,\n            height: eyeSize,\n            color: WHITE,\n        });\n\n\n        // RIGHT EYE WHITE\n        drawRect({\n            pos: vec2(\n                faceX + eyeOffset - eyeSize,\n                eyeY\n            ),\n            width: eyeSize,\n            height: eyeSize,\n            color: WHITE,\n        });\n\n\n        // LEFT PUPIL\n        drawRect({\n            pos: vec2(\n                faceX - eyeOffset + eyeSize * 0.30,\n                eyeY + eyeSize * 0.20\n            ),\n            width: eyeSize * 0.40,\n            height: eyeSize * 0.60,\n            color: BLACK,\n        });\n\n\n        // RIGHT PUPIL\n        drawRect({\n            pos: vec2(\n                faceX + eyeOffset - eyeSize * 0.70,\n                eyeY + eyeSize * 0.20\n            ),\n            width: eyeSize * 0.40,\n            height: eyeSize * 0.60,\n            color: BLACK,\n        });\n\n\n        // Bigger mouth\n        drawRect({\n            pos: vec2(\n                faceX - enemyWidth * 0.30,\n                faceY + enemyHeight * 0.22\n            ),\n            width: enemyWidth * 0.60,\n            height: enemyHeight * 0.12,\n            color: BLACK,\n        });\n\n\n        // Left tooth\n        drawRect({\n            pos: vec2(\n                faceX - enemyWidth * 0.20,\n                faceY + enemyHeight * 0.22\n            ),\n            width: enemyWidth * 0.10,\n            height: enemyHeight * 0.12,\n            color: WHITE,\n        });\n\n\n        // Right tooth\n        drawRect({\n            pos: vec2(\n                faceX + enemyWidth * 0.10,\n                faceY + enemyHeight * 0.22\n            ),\n            width: enemyWidth * 0.10,\n            height: enemyHeight * 0.12,\n            color: WHITE,\n        });\n    }\n}\n                            });\n                    }\n                }\n\n                const cx = screenW / 2;\n                const cy = screenH / 2;        \n                \n                const hudHeight = 50;        \n                if (this.muzzleFlash > 0) {\n                    drawRect({\n                        width: screenW,\n                        height: screenH,\n                        color: rgb(255, 255, 200),\n                        opacity: this.muzzleFlash * 1.5,\n                    });\n                }\n\n                /*// Weapon\n                drawRect({\n                    pos: vec2(cx, screenH - 5),\n                    width: 40,\n                    height: 18,\n                    anchor: \"bot\",\n                    color: rgb(70, 70, 70),\n                });\n\n                drawRect({\n                    pos: vec2(cx, screenH - 23),\n                    width: 14,\n                    height: 45,\n                    anchor: \"bot\",\n                    color: rgb(90, 90, 90),\n                }); */\n                // Improved pistol weapon model\n                if (this.showMinimap) {\n    // ---- MINIMAP: top-right corner, below HUD bar ----\n    const minimapSize = 220;\n    const margin = 12;\n    const minimapX = screenW - minimapSize - margin;\n    const minimapY = hudHeight + 5;\n\n    // Semi-transparent background\n    drawRect({\n        pos: vec2(minimapX, minimapY),\n        width: minimapSize,\n        height: minimapSize,\n        color: BLACK,\n        opacity: 0.75,\n    });\n\n    const gridH = grid.length;\n    const gridW = grid[0] ? grid[0].length : 0;\n\n    if (gridW > 0 && gridH > 0) {\n\n        const cellW = minimapSize / gridW;\n        const cellH = minimapSize / gridH;\n\n        // Draw map cells\n        for (let y = 0; y < gridH; y++) {\n            for (let x = 0; x < gridW; x++) {\n\n                const ch = grid[y][x];\n\n                let col;\n                if (ch === \"#\") {\n                    col = rgb(120, 60, 60); // walls\n                }\n                else if (ch === \"L\") {\n                    col = rgb(255, 180, 0); // lava\n                }\n                else {\n                    col = rgb(80, 80, 80); // floor\n                }\n\n                drawRect({\n                    pos: vec2(\n                        minimapX + x * cellW,\n                        minimapY + y * cellH\n                    ),\n                    width: cellW,\n                    height: cellH,\n                    color: col,\n                });\n            }\n        }\n\n\n        // Player position\n        const gx = Math.floor(this.pos.x / 16);\n        const gy = Math.floor(this.pos.y / 16);\n\n        if (gx >= 0 && gx < gridW && gy >= 0 && gy < gridH) {\n\n            drawRect({\n                pos: vec2(\n                    minimapX + gx * cellW,\n                    minimapY + gy * cellH\n                ),\n                width: cellW,\n                height: cellH,\n                color: rgb(0, 255, 0),\n            });\n\n        }\n\n\n        // Enemy positions\n        for (const spawn of ENEMY_SPAWNS) {\n\n            const ePos = spawn.pos || spawn;\n\n            const ex = Math.floor(ePos.x / 16);\n            const ey = Math.floor(ePos.y / 16);\n\n            if (ex >= 0 && ex < gridW && ey >= 0 && ey < gridH) {\n\n                drawRect({\n                    pos: vec2(\n                        minimapX + ex * cellW,\n                        minimapY + ey * cellH\n                    ),\n                    width: cellW,\n                    height: cellH,\n                    color: rgb(255, 50, 50),\n                });\n\n            }\n        }\n\n\n        // Border\n        drawRect({\n            pos: vec2(minimapX, minimapY),\n            width: minimapSize,\n            height: minimapSize,\n            color: WHITE,\n            opacity: 0.8,\n            fill: false,\n            stroke: 2,\n        });\n\n\n        // MAP label\n        drawText({\n            text: \"MAP\",\n            pos: vec2(minimapX + 4, minimapY + 4),\n            size: 10,\n            color: WHITE,\n            opacity: 0.9,\n        });\n    }\n}\nconst bob = Math.sin(time() * 8) * 2;;\n\n// Simple pixel-art pistol with long barrel + iron sights\n\nconst gunX = cx;\nconst gunY = screenH + 20 + bob;\n\n// Wide stock / receiver near player\ndrawRect({\n    pos: vec2(gunX, gunY - 10),\n    width: 130,\n    height: 70,\n    anchor: \"bot\",\n    color: rgb(55, 55, 55),\n});\n\n// Middle section\ndrawRect({\n    pos: vec2(gunX, gunY - 70),\n    width: 85,\n    height: 80,\n    anchor: \"bot\",\n    color: rgb(80, 80, 80),\n});\n\n// Long barrel narrowing toward center\ndrawRect({\n    pos: vec2(gunX, gunY - 130),\n    width: 45,\n    height: 80,\n    anchor: \"bot\",\n    color: rgb(105, 105, 105),\n});\n\n// Slight top highlight for metal depth\ndrawRect({\n    pos: vec2(gunX, gunY - 130),\n    width: 30,\n    height: 70,\n    anchor: \"bot\",\n    color: rgb(125, 125, 125),\n});\n\n\n// Barrel opening\ndrawRect({\n    pos: vec2(gunX, gunY - 175),\n    width: 50,\n    height: 12,\n    anchor: \"bot\",\n    color: rgb(25, 25, 25),\n});\n\n// Iron sight posts\ndrawRect({\n    pos: vec2(gunX - 12, gunY - 190),\n    width: 7,\n    height: 18,\n    anchor: \"bot\",\n    color: rgb(30, 30, 30),\n});\n\ndrawRect({\n    pos: vec2(gunX + 12, gunY - 190),\n    width: 7,\n    height: 18,\n    anchor: \"bot\",\n    color: rgb(30, 30, 30),\n});\n\n// Sight bridge\ndrawRect({\n    pos: vec2(gunX, gunY - 190),\n    width: 32,\n    height: 4,\n    anchor: \"bot\",\n    color: rgb(20, 20, 20),\n});\n\n                // Sword swing\n                if (this.swordSwing > 0) {\n                    const swingT = 1 - (this.swordSwing / 0.2);\n                    const angleDeg = lerp(-60, 60, swingT);\n\n                    pushTransform();\n                    pushTranslate(vec2(cx, cy + 30));\n                    pushRotate(angleDeg);\n\n                    drawLine({\n                        p1: vec2(0, 0),\n                        p2: vec2(0, -90),\n                        width: 6,\n                        color: WHITE,\n                    });\n\n                    popTransform();\n                }\n\n                // Crosshair\n                drawLine({\n                    p1: vec2(cx - 6, cy),\n                    p2: vec2(cx + 6, cy),\n                    width: 1,\n                    color: WHITE,\n                });\n\n                drawLine({\n                    p1: vec2(cx, cy - 6),\n                    p2: vec2(cx, cy + 6),\n                    width: 1,\n                    color: WHITE,\n                });\n\n                // HUD\n                drawRect({\n                    pos: vec2(0, 0),\n    width: screenW,\n    height: hudHeight,\n    color: BLACK,\n    opacity: 0.6,\n                });\n\n                drawText({\n                    text: `HP ${Math.round(Math.max(0, this.hp))}`,\n    pos: vec2(20, 12),\n    size: 18,\n    color: WHITE,\n                });\n\n                drawText({\n                    text: `Kills ${this.score}/${ENEMY_SPAWNS.length}`,\n    pos: vec2(screenW / 2, 12),\n    anchor: \"center\",\n    size: 18,\n    color: WHITE,\n                });\n\n                drawText({\n                    text: `Weapon: ${this.currentWeapon} (1=sword 2=gun)`,\n                    pos: vec2(4, 15),\n                    size: 0,\n                    opacity : 0,\n                    color: WHITE,\n                });\n\n                const owned = Object.keys(this.weapons).filter(\n                    (id) => this.weapons[id]\n                );\n\n                drawText({\n                    text: `Inventory: ${owned.join(\", \") || \"none\"}`,\n                    pos: vec2(4, 27),\n                    size: 0,\n                    opacity : 0,\n                    color: WHITE,\n                });\n\n                drawText({\n                    text: `Floor ${currentFloor}/${MAX_FLOORS}  Crystals ${crystalsCollected}/${CRYSTALS_PER_FLOOR}`,\n    pos: vec2(screenW - 20, 12),\n    anchor: \"right\",\n    size: 16,\n    color: rgb(80, 220, 255),\n                });\n\n                if (this.pickupMessage && this.pickupMessageTimer > 0) {\n                    drawRect({\n                        pos: vec2(cx, 44),\n                        width: 120,\n                        height: 16,\n                        anchor: \"top\",\n                        color: BLACK,\n                        opacity: 0.6,\n                    });\n\n                    drawText({\n                        text: this.pickupMessage,\n                        pos: vec2(cx, 52),\n                        size: 14,\n                        anchor: \"center\",\n                        color: rgb(255, 210, 60),\n                    });\n                }\n\n                if (this.wonRun) {\n                    drawRect({\n                        width: screenW,\n                        height: screenH,\n                        color: BLACK,\n                        opacity: 0.6,\n                    });\n\n                    drawText({\n                        text: \"YOU WIN!\",\n                        pos: vec2(cx, cy - 20),\n                        size: 16,\n                        anchor: \"center\",\n                        color: rgb(80, 220, 255),\n                    });\n\n                    drawText({\n                        text: `All ${MAX_FLOORS} floors cleared`,\n                        pos: vec2(cx, cy),\n                        size: 9,\n                        anchor: \"center\",\n                        color: WHITE,\n                    });\n\n                    drawText({\n                        text: \"Enter = Neustart\",\n                        pos: vec2(cx, cy + 18),\n                        size: 10,\n                        anchor: \"center\",\n                        color: WHITE,\n                    });\n                }\n                else if (this.gameOver) {\n\n                    drawRect({\n                        width: screenW,\n                        height: screenH,\n                        color: BLACK,\n                        opacity: 0.6,\n                    });\n\n                    drawText({\n                        text: \"GAME OVER\",\n                        pos: vec2(cx, cy - 10),\n                        size: 16,\n                        anchor: \"center\",\n                        color: RED,\n                    });\n\n                    drawText({\n                        text: \"Enter = Neustart\",\n                        pos: vec2(cx, cy + 12),\n                        size: 10,\n                        anchor: \"center\",\n                        color: WHITE,\n                    });\n\n                }\n                else if (this.score >= ENEMY_SPAWNS.length) {\n\n                    drawRect({\n                        width: screenW,\n                        height: screenH,\n                        color: BLACK,\n                        opacity: 0.6,\n                    });\n\n                    drawText({\n                        text: \"GESCHAFFT!\",\n                        pos: vec2(cx, cy - 10),\n                        size: 16,\n                        anchor: \"center\",\n                        color: rgb(120, 255, 120),\n                    });\n\n                    drawText({\n                        text: \"Enter = Neustart\",\n                        pos: vec2(cx, cy + 12),\n                        size: 10,\n                        anchor: \"center\",\n                        color: WHITE,\n                    });\n                }\n\n                popTransform();\n            },\n\n            focalLength: 70,\n            fov: 35,\n            hp: 100,\n            score: 0,\n            gameOver: false,\n            shootCooldown: 0,\n            muzzleFlash: 1,\n            pickupMessage: \"\",\n            pickupMessageTimer: 0,\n            weapons: { gun: true },\n            currentWeapon: \"gun\",\n            wonRun: false,\n            floorComplete: false,\n            showMinimap: true,\n        },\n    ]);\n}","language":"javascript","path":"objects/player.js"}],["objects/enemies.js",{"kind":"obj","value":"// 5) Enemy state + AI - imported by utils/raycast.js (to test billboard\n//    hits), objects/player.js (for ENEMY_SPAWNS.length in the HUD) and\n//    scenes/game.js.\n//\n// Enemies are plain data objects (not full KAPLAY entities) so the\n// raycaster can treat them as billboards cheaply - each one also gets a\n// small marker object added just so you can see it moving on the top-down\n// debug view in the background.\n//\n// spawnEnemies() must be called from inside scene(\"game\", ...) (see\n// scenes/game.js), same reasoning as buildLevel() in objects/level.js -\n// add()'ing the marker objects only works once a scene is actually\n// running, and calling it again on every scene restart is what resets\n// the enemies.\n//\n// `enemies` is exported as a `let` and reassigned inside spawnEnemies() -\n// ES module imports are \"live bindings\", so utils/raycast.js always sees\n// the current array, including after a restart.\n\nimport k from \"../kaplay.js\";\nconst { vec2, add, pos, circle, color, z, anchor, destroy, dt } = k;\nimport { grid, isWallChar } from \"./objects/level.js\";\nimport { rayCastGrid } from \"../utils/raycast.js\";\nimport { spawnProjectile } from \"./objects/projectiles.js\";\n\nexport let ENEMY_SPAWNS = [];\nexport function setEnemySpawns(list) {\n    ENEMY_SPAWNS = list;\n}\n\nexport let enemies = [];\n\nexport function spawnEnemies() {\n    for (const e of enemies) {\n        if (e.marker) destroy(e.marker);\n    }\n    enemies = ENEMY_SPAWNS.map((spawnEntry) => {\n        // Spawn entries are normally plain vec2s (melee enemy at that\n        // position), but can also be { pos, kind: \"shooter\" } objects for\n        // the purple ranged enemy - see scenes/room2.js.\n        const spawnPos = spawnEntry.pos ? spawnEntry.pos : spawnEntry;\n        const kind = spawnEntry.kind || \"melee\";\n        const markerColor = kind === \"shooter\" ? [160, 32, 240] : [200, 60, 60];\n\n        const e = {\n            pos: spawnPos.clone(),\n            kind,\n            hp: 100,\n            dead: false,\n            hitFlash: 0,\n            attackCooldown: 0,\n            shootCooldown: 1, // shooters wait a beat before their first shot\n        };\n        e.marker = add([\n            pos(e.pos),\n            circle(4),\n            color(...markerColor),\n            z(1),\n            anchor(\"center\"),\n        ]);\n        return e;\n    });\n}\n\n// --- Wall collision + line-of-sight helpers -------------------------------\n// Enemies are plain data objects (see comment above), so unlike the player\n// (which gets wall collision for free via KAPLAY's body()/area() physics)\n// they need their own manual collision check against the wall grid, and\n// their own visibility check before they're allowed to start chasing.\n\nconst ENEMY_RADIUS = 4;\nconst SIGHT_RANGE = 200;\n\nfunction tileAt(x, y) {\n    if (y < 0 || y >= grid.length) return \"#\";\n    const row = grid[y];\n    if (x < 0 || x >= row.length) return \"#\";\n    return row[x];\n}\n\nfunction isWallAtPos(p) {\n    return isWallChar(tileAt(Math.floor(p.x / 16), Math.floor(p.y / 16)));\n}\n\n// Circle-vs-grid check: samples 4 points around the enemy's collision\n// radius instead of just its center, so it can't clip a corner into a wall.\nfunction collides(p) {\n    return (\n        isWallAtPos(vec2(p.x - ENEMY_RADIUS, p.y)) ||\n        isWallAtPos(vec2(p.x + ENEMY_RADIUS, p.y)) ||\n        isWallAtPos(vec2(p.x, p.y - ENEMY_RADIUS)) ||\n        isWallAtPos(vec2(p.x, p.y + ENEMY_RADIUS))\n    );\n}\n\n// Moves per-axis and cancels whichever axis would collide, so enemies slide\n// along walls instead of just freezing when they hit one at an angle.\nfunction moveWithCollision(pos, delta) {\n    let x = pos.x;\n    let y = pos.y;\n    if (!collides(vec2(x + delta.x, y))) x += delta.x;\n    if (!collides(vec2(x, y + delta.y))) y += delta.y;\n    return vec2(x, y);\n}\n\n// Reuses the same generic DDA grid raycaster utils/raycast.js already uses\n// for the first-person view - walks the grid from the enemy to the player\n// and returns true only if nothing solid is in between.\nfunction hasLineOfSight(fromPos, toPos) {\n    const o = fromPos.scale(1 / 16);\n    const d = toPos.sub(fromPos).scale(1 / 16);\n    const hit = rayCastGrid(o, d, ({ x, y }) => isWallChar(tileAt(x, y)), d.len());\n    return hit === null;\n}\n\n\n// Chase-and-attack AI, ticked once per frame from scenes/game.js's\n// onUpdate. Returns the total damage enemies landed on the player this\n// frame (0 if none), so the caller decides how to apply it instead of this\n// file reaching into player/game state directly. Note: enemies currently\n// Enemies now respect the wall grid (moveWithCollision, see the helpers\n// above) and only start chasing once hasLineOfSight() confirms they can\n// actually see the player - see the helper block above updateEnemies.\nconst SHOOTER_FIRE_INTERVAL = 2; // seconds between shots\n\nexport function updateEnemies(playerPos) {\n    let damage = 0;\n\n    for (const e of enemies) {\n        if (e.dead) continue;\n        if (e.hitFlash > 0) e.hitFlash -= dt();\n\n        const toPlayer = playerPos.sub(e.pos);\n        const dist = toPlayer.len();\n\n        if (e.kind === \"shooter\") {\n            // Stationary turret: doesn't chase, just fires a slow projectile\n            // at the player on an interval whenever it can see them.\n            if (dist < SIGHT_RANGE && hasLineOfSight(e.pos, playerPos)) {\n                e.shootCooldown -= dt();\n                if (e.shootCooldown <= 0) {\n                    e.shootCooldown = SHOOTER_FIRE_INTERVAL;\n                    spawnProjectile(e.pos, playerPos);\n                }\n            }\n        } else {\n            // Default \"melee\" behavior: chase once in sight range, and\n            // deal contact damage once close enough.\n            if (dist < SIGHT_RANGE && dist > 16 && hasLineOfSight(e.pos, playerPos)) {\n                const delta = toPlayer.unit().scale(28 * dt());\n                e.pos = moveWithCollision(e.pos, delta);\n            }\n\n            if (dist <= 16) {\n                e.attackCooldown -= dt();\n                if (e.attackCooldown <= 0) {\n                    e.attackCooldown = 1;\n                    damage += 10;\n                }\n            }\n        }\n\n        e.marker.pos = e.pos;\n    }\n\n    return damage;\n}\n","language":"javascript","path":"objects/enemies.js"}],["objects/level.js",{"kind":"obj","value":"import k from \"../kaplay.js\";\nconst { vec2, addLevel, rect, color, area, body, RED, GREEN, BLUE, opacity } = k;\nimport { CRYSTALS_PER_FLOOR } from \"./objects/progress.js\";\n\nexport const TILE = 16;\nexport const ROOM = 5;\nexport const WALL = 1;\nexport const MACRO_W = 5;\nexport const MACRO_H = 5;\nconst CELL = ROOM + WALL;\nexport const colors = {\n    \"#\": RED,\n    \"$\": GREEN,\n    \"%\": BLUE,\n};\nexport function isWallChar(ch) {\n    return colors[ch] !== undefined;\n}\nexport let grid = [];\nexport let playerSpawn = vec2(TILE * 3, TILE * 3);\nexport let enemySpawns = [];\n\nfunction emptyGrid() {\n    const width = MACRO_W * CELL + WALL;\n    const height = MACRO_H * CELL + WALL;\n    const rows = [];\n    for (let y = 0; y < height; y++) {\n        const row = [];\n        for (let x = 0; x < width; x++) {\n            row.push(\"#\");\n        }\n        rows.push(row);\n    }\n    return rows;\n}\n\nfunction shuffle(arr) {\n    for (let i = arr.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        const tmp = arr[i];\n        arr[i] = arr[j];\n        arr[j] = tmp;\n    }\n    return arr;\n}\n\nfunction carveRooms(rows) {\n    for (let cy = 0; cy < MACRO_H; cy++) {\n        for (let cx = 0; cx < MACRO_W; cx++) {\n            const originY = WALL + cy * CELL;\n            const originX = WALL + cx * CELL;\n            for (let y = 0; y < ROOM; y++) {\n                for (let x = 0; x < ROOM; x++) {\n                    rows[originY + y][originX + x] = \" \";\n                }\n            }\n        }\n    }\n}\n\nfunction buildSpanningTree() {\n    const visited = [];\n    for (let cy = 0; cy < MACRO_H; cy++) {\n        const row = [];\n        for (let cx = 0; cx < MACRO_W; cx++) {\n            row.push(false);\n        }\n        visited.push(row);\n    }\n    const edges = [];\n    const stack = [{ x: 0, y: 0 }];\n    visited[0][0] = true;\n    while (stack.length > 0) {\n        const current = stack[stack.length - 1];\n        const neighbors = [];\n        if (current.x > 0 && !visited[current.y][current.x - 1]) neighbors.push({ x: current.x - 1, y: current.y });\n        if (current.x < MACRO_W - 1 && !visited[current.y][current.x + 1]) neighbors.push({ x: current.x + 1, y: current.y });\n        if (current.y > 0 && !visited[current.y - 1][current.x]) neighbors.push({ x: current.x, y: current.y - 1 });\n        if (current.y < MACRO_H - 1 && !visited[current.y + 1][current.x]) neighbors.push({ x: current.x, y: current.y + 1 });\n        if (neighbors.length === 0) {\n            stack.pop();\n            continue;\n        }\n        const next = neighbors[Math.floor(Math.random() * neighbors.length)];\n        visited[next.y][next.x] = true;\n        edges.push({ from: current, to: next });\n        stack.push(next);\n    }\n    return edges;\n}\n\nfunction carveDoors(rows, edges) {\n    const mid = Math.floor(ROOM / 2);\n    for (const edge of edges) {\n        const a = edge.from;\n        const b = edge.to;\n        if (b.x === a.x + 1) {\n            rows[WALL + a.y * CELL + mid][WALL + a.x * CELL + ROOM] = \" \";\n        } else if (b.x === a.x - 1) {\n            rows[WALL + a.y * CELL + mid][WALL + b.x * CELL + ROOM] = \" \";\n        } else if (b.y === a.y + 1) {\n            rows[WALL + a.y * CELL + ROOM][WALL + a.x * CELL + mid] = \" \";\n        } else if (b.y === a.y - 1) {\n            rows[WALL + b.y * CELL + ROOM][WALL + a.x * CELL + mid] = \" \";\n        }\n    }\n}\n\nfunction roomCenterWorld(cx, cy) {\n    const mid = Math.floor(ROOM / 2);\n    const tileY = WALL + cy * CELL + mid;\n    const tileX = WALL + cx * CELL + mid;\n    return vec2(tileX * TILE + TILE / 2, tileY * TILE + TILE / 2);\n}\n\nfunction tileWorld(originX, originY, x, y) {\n    return vec2((originX + x) * TILE + TILE / 2, (originY + y) * TILE + TILE / 2);\n}\n\n// Carves a lava strip across an entire macro room, splitting it into an\n// entrance side and a far side that can only be reached by crossing the\n// lava (or shot across, for ranged enemies). `doorSide` is which wall of\n// this room has its only connection in the spanning tree (\"N\"/\"S\"/\"E\"/\"W\").\n// Returns the world-space spawn positions for two enemies placed on the far\n// side, away from the entrance.\nfunction applyLavaArena(rows, cx, cy, doorSide) {\n    const originY = WALL + cy * CELL;\n    const originX = WALL + cx * CELL;\n    const mid = Math.floor(ROOM / 2);\n    const spawnTiles = [];\n    if (doorSide === \"E\" || doorSide === \"W\") {\n        for (let y = 0; y < ROOM; y++) {\n            for (let x = mid - 1; x <= mid + 1; x++) {\n                rows[originY + y][originX + x] = \"L\";\n            }\n        }\n        const farCol = doorSide === \"E\" ? 0 : ROOM - 1;\n        spawnTiles.push({ x: farCol, y: 1 }, { x: farCol, y: ROOM - 2 });\n    } else {\n        for (let y = mid - 1; y <= mid + 1; y++) {\n            for (let x = 0; x < ROOM; x++) {\n                rows[originY + y][originX + x] = \"L\";\n            }\n        }\n        const farRow = doorSide === \"S\" ? 0 : ROOM - 1;\n        spawnTiles.push({ x: 1, y: farRow }, { x: ROOM - 2, y: farRow });\n    }\n    return spawnTiles.map(({ x, y }) => tileWorld(originX, originY, x, y));\n}\n\nfunction applyLava(rows, cx, cy) {\n    const mid = Math.floor(ROOM / 2);\n    const originY = WALL + cy * CELL;\n    const originX = WALL + cx * CELL;\n    for (let y = mid - 1; y <= mid + 1; y++) {\n        for (let x = mid - 1; x <= mid + 1; x++) {\n            rows[originY + y][originX + x] = \"L\";\n        }\n    }\n}\n\nexport function generateLevel() {\n    const rows = emptyGrid();\n    carveRooms(rows);\n\n    const cells = [];\n    for (let cy = 0; cy < MACRO_H; cy++) {\n        for (let cx = 0; cx < MACRO_W; cx++) {\n            cells.push({ x: cx, y: cy });\n        }\n    }\n    // The run always starts in the middle of the map (not the top-left\n    // corner) - see the \"multiple exits\" note below for why that matters.\n    const startCell = { x: Math.floor(MACRO_W / 2), y: Math.floor(MACRO_H / 2) };\n\n    const edges = buildSpanningTree();\n\n    // The spanning tree only guarantees each room has *at least* one\n    // connection (it's a tree - no loops), so the start room could easily\n    // end up with just a single exit. Multiple exits are allowed/expected\n    // for the start room, so force every in-bounds neighbor of startCell to\n    // be connected, adding any edges the spanning tree didn't already\n    // create, before doors get carved from `edges` below.\n    const hasEdge = (a, b) => edges.some((e) =>\n        (e.from.x === a.x && e.from.y === a.y && e.to.x === b.x && e.to.y === b.y) ||\n        (e.to.x === a.x && e.to.y === a.y && e.from.x === b.x && e.from.y === b.y)\n    );\n    const inBoundsNeighbors = (c) => {\n        const list = [];\n        if (c.x > 0) list.push({ x: c.x - 1, y: c.y });\n        if (c.x < MACRO_W - 1) list.push({ x: c.x + 1, y: c.y });\n        if (c.y > 0) list.push({ x: c.x, y: c.y - 1 });\n        if (c.y < MACRO_H - 1) list.push({ x: c.x, y: c.y + 1 });\n        return list;\n    };\n    for (const n of inBoundsNeighbors(startCell)) {\n        if (!hasEdge(startCell, n)) edges.push({ from: startCell, to: n });\n    }\n\n    carveDoors(rows, edges);\n\n    // Pick a leaf cell (exactly one connection in the spanning tree, so it\n    // has exactly one entrance) other than the start room to become a\n    // special lava arena: two stationary purple shooters guard the far\n    // side of a lava pit that separates them from the room's only door.\n    const degree = (c) => edges.filter((e) =>\n        (e.from.x === c.x && e.from.y === c.y) || (e.to.x === c.x && e.to.y === c.y)\n    ).length;\n    const leafCells = cells.filter((c) =>\n        !(c.x === startCell.x && c.y === startCell.y) && degree(c) === 1\n    );\n    let arenaCell = null;\n    let arenaSpawns = [];\n    if (leafCells.length > 0) {\n        arenaCell = leafCells[Math.floor(Math.random() * leafCells.length)];\n        const edge = edges.find((e) =>\n            (e.from.x === arenaCell.x && e.from.y === arenaCell.y) ||\n            (e.to.x === arenaCell.x && e.to.y === arenaCell.y)\n        );\n        const other = (edge.from.x === arenaCell.x && edge.from.y === arenaCell.y) ? edge.to : edge.from;\n        let doorSide;\n        if (other.x === arenaCell.x + 1) doorSide = \"E\";\n        else if (other.x === arenaCell.x - 1) doorSide = \"W\";\n        else if (other.y === arenaCell.y + 1) doorSide = \"S\";\n        else doorSide = \"N\";\n        arenaSpawns = applyLavaArena(rows, arenaCell.x, arenaCell.y, doorSide);\n    }\n\n    // Remaining rooms are shuffled and handed out to: CRYSTALS_PER_FLOOR\n    // crystal rooms (the floor-progress goal, see objects/progress.js and\n    // objects/items.js's \"crystal\" item type) first, then up to 5\n    // melee-enemy rooms, then whatever's left gets a chance of lava decor.\n    const pool = shuffle(cells.filter((c) =>\n        !(c.x === startCell.x && c.y === startCell.y) &&\n        !(arenaCell && c.x === arenaCell.x && c.y === arenaCell.y)\n    ));\n    const crystalCount = Math.min(CRYSTALS_PER_FLOOR, pool.length);\n    const crystalCells = pool.slice(0, crystalCount);\n    const rest = pool.slice(crystalCount);\n    const enemyCount = Math.min(5, rest.length);\n    const enemyCells = rest.slice(0, enemyCount);\n    const decorCells = rest.slice(enemyCount);\n    for (const cell of decorCells) {\n        if (Math.random() < 0.35) applyLava(rows, cell.x, cell.y);\n    }\n    playerSpawn = roomCenterWorld(startCell.x, startCell.y);\n    const meleeSpawns = enemyCells.map((cell) => roomCenterWorld(cell.x, cell.y));\n    const shooterSpawns = arenaSpawns.map((p) => ({ pos: p, kind: \"shooter\" }));\n    enemySpawns = meleeSpawns.concat(shooterSpawns);\n    const crystalSpawns = crystalCells.map((cell) => roomCenterWorld(cell.x, cell.y));\n    grid = rows.map((row) => row.join(\"\"));\n    return { grid, playerSpawn, enemySpawns, crystalSpawns };\n}\n\n// Sets a fixed, hand-authored level layout instead of the procedurally\n// generated one from generateLevel() - used by scenes/room2.js. `rows` must\n// be an array of equal-length strings using the same tile chars as\n// generateLevel() (\"#\" wall, \" \" floor, \"L\" lava); `spawn` is where the\n// player starts.\n//\n// -----------------------------------------------------------------------\n// HOW TO ADD A NEW (HAND-BUILT) ROOM LAYOUT TYPE - step by step:\n//\n// scenes/room2.js is the template - copy the whole file to make a new\n// room, e.g. scenes/room3.js, then:\n//\n// 1. Edit its ROWS array (renamed e.g. ROOM3_ROWS) - a plain array of\n//    equal-length strings. \"#\" = wall, \" \" = floor, \"L\" = lava. Want a\n//    new tile type (locked door, water, whatever)? Add a character for\n//    it to the `colors` map up above and a matching entry to the\n//    `tiles` object inside buildLevel() below.\n//\n// 2. Change the scene(\"room2\", ...) name to scene(\"room3\", ...) (or\n//    whatever you called the file) and update the setCustomLevel(...)\n//    spawn position to wherever the player should start in the new grid.\n//\n// 3. Update the setEnemySpawns([...]) call: plain vec2(x, y) entries\n//    spawn a melee enemy there, `{ pos, kind: \"shooter\" }` spawns a\n//    purple ranged one (see objects/enemies.js).\n//\n// 4. Update the setItemSpawns([...]) call (see objects/items.js) to\n//    place whatever chests the new room should have, e.g.\n//    `{ pos: vec2(...), item: \"gun\" }`. Leave it `[]` for no chests.\n//\n// 5. In main.js, add `import \"./scenes/room3.js\";` next to the existing\n//    scene imports (this is what actually registers the scene).\n//\n// 6. Add a way to reach it: an onKeyPress(...) in another room that\n//    calls go(\"room3\") (see the \"n\" key in scenes/game.js that warps to\n//    \"room2\"), and a key in the new room to go back (see the \"b\" key in\n//    scenes/room2.js).\n//\n// Everything else - movement, shooting, the sword, the HUD, item pickup -\n// is copied verbatim from scenes/room2.js and needs no changes, since it\n// all reads from objects/player.js's createCamera() and the generic\n// enemies/items/projectiles systems.\n// -----------------------------------------------------------------------\nexport function setCustomLevel(rows, spawn) {\n    grid = rows;\n    playerSpawn = spawn;\n}\n\nexport function buildLevel() {\n    addLevel(grid, {\n        pos: vec2(0, 0),\n        tileWidth: TILE,\n        tileHeight: TILE,\n        tiles: {\n            \"#\": () => [rect(TILE, TILE), color(RED), opacity(0), area(), body({ isStatic: true })],\n            \"$\": () => [rect(TILE, TILE), color(GREEN), opacity(0), area(), body({ isStatic: true })],\n            \"%\": () => [rect(TILE, TILE), color(BLUE), opacity(0), area(), body({ isStatic: true })],\n            \"L\": () => [rect(TILE, TILE), color(255, 140, 0), opacity(0)],\n        },\n    });\n}\n\nexport function isLavaAt(pos) {\n    const gx = Math.floor(pos.x / TILE);\n    const gy = Math.floor(pos.y / TILE);\n    if (gy < 0 || gy >= grid.length) return false;\n    const row = grid[gy];\n    if (gx < 0 || gx >= row.length) return false;\n    return row[gx] === \"L\";\n}\n","language":"javascript","path":"objects/level.js"}],["utils/raycast.js",{"kind":"util","value":"// 3) Pure raycasting helpers, imported by objects/player.js and\n//    scenes/game.js.\n//\n// rayCastGrid and raycastEdge don't know anything about walls or enemies -\n// they're generic grid-DDA and line-intersection math. rayCastAsciiGrid is\n// the game-specific glue: it walks the wall grid (passed in by the caller)\n// AND separately tests every living enemy as a camera-facing billboard\n// plane, which is why it needs `enemies` imported from objects/enemies.js.\n\nimport k from \"../kaplay.js\";\nconst { vec2 } = k;\nimport { enemies } from \"../objects/enemies.js\";\nimport { projectiles } from \"../objects/projectiles.js\";\nimport { items } from \"../objects/items.js\";\nimport { colors, isWallChar } from \"../objects/level.js\";\n\nexport function rayCastGrid(origin, direction, gridPosHit, maxDistance = 64) {\n    const pos = origin;\n    const len = direction.len();\n    const dir = direction.scale(1 / len);\n    let t = 0;\n    let gridPos = vec2(Math.floor(origin.x), Math.floor(origin.y));\n    const step = vec2(dir.x > 0 ? 1 : -1, dir.y > 0 ? 1 : -1);\n    const tDelta = vec2(Math.abs(1 / dir.x), Math.abs(1 / dir.y));\n    let dist = vec2(\n        (step.x > 0) ? (gridPos.x + 1 - origin.x) : (origin.x - gridPos.x),\n        (step.y > 0) ? (gridPos.y + 1 - origin.y) : (origin.y - gridPos.y),\n    );\n    let tMax = vec2(\n        (tDelta.x < Infinity) ? tDelta.x * dist.x : Infinity,\n        (tDelta.y < Infinity) ? tDelta.y * dist.y : Infinity,\n    );\n    let steppedIndex = -1;\n    while (t <= maxDistance) {\n        const hit = gridPosHit(gridPos);\n        if (hit === true) {\n            const point = pos.add(dir.scale(t));\n            return {\n                point,\n                normal: vec2(\n                    steppedIndex === 0 ? -step.x : 0,\n                    steppedIndex === 1 ? -step.y : 0,\n                ),\n                // Fractional position (0..1) across the hit cell's face,\n                // used to pick which column of a wall texture to sample\n                // (see objects/player.js's textured wall rendering). A\n                // vertical face (stepped in x) varies along y, and vice\n                // versa.\n                u: steppedIndex === 0\n                    ? point.y - Math.floor(point.y)\n                    : point.x - Math.floor(point.x),\n                t: t / len,\n                gridPos,\n            };\n        }\n        else if (hit) {\n            return hit;\n        }\n        if (tMax.x < tMax.y) {\n            gridPos.x += step.x;\n            t = tMax.x;\n            tMax.x += tDelta.x;\n            steppedIndex = 0;\n        }\n        else {\n            gridPos.y += step.y;\n            t = tMax.y;\n            tMax.y += tDelta.y;\n            steppedIndex = 1;\n        }\n    }\n\n    return null;\n}\n\nexport function raycastEdge(origin, direction, line) {\n    const a = origin;\n    const c = line.p1.add(line.pos);\n    const d = line.p2.add(line.pos);\n    const ab = direction;\n    const cd = d.sub(c);\n    let abxcd = ab.cross(cd);\n    if (Math.abs(abxcd) < Number.EPSILON) {\n        return false;\n    }\n    const ac = c.sub(a);\n    const s = ac.cross(cd) / abxcd;\n    if (s <= 0 || s >= 1) {\n        return false;\n    }\n    const t = ac.cross(ab) / abxcd;\n    if (t <= 0 || t >= 1) {\n        return false;\n    }\n\n    const normal = cd.normal().unit();\n    if (direction.dot(normal) > 0) {\n        normal.x *= -1;\n        normal.y *= -1;\n    }\n\n    return {\n        point: a.add(ab.scale(s)),\n        normal: normal,\n        t: s,\n        // Position (0..1) along the billboard's p1->p2 width - used to pick\n        // which column of the enemy/projectile/item texture to sample (see\n        // objects/player.js's textured billboard rendering).\n        s: t,\n        object: line,\n    };\n}\n\n// Casts one column's ray through the wall grid, AND separately tests every\n// living enemy as a billboard. Returns { t, object, point, normal, objects }\n// where `objects` is an array of enemy hits (possibly empty), each tagged\n// with `.enemy` so callers know which enemy was hit.\nexport function rayCastAsciiGrid(origin, direction, grid) {\n    const o = origin.scale(1 / 16);\n    const d = direction.scale(1 / 16);\n\n    const wallHit = rayCastGrid(o, d, ({ x, y }) => {\n        if (y >= 0 && y < grid.length) {\n            const row = grid[y];\n            if (x >= 0 && x < row.length) {\n                return isWallChar(row[x]);\n            }\n        }\n        return false;\n    }, d.len());\n\n    const objects = [];\n    const perp = d.normal().unit().scale(0.15);\n    for (const e of enemies) {\n        if (e.dead) continue;\n        const hit = raycastEdge(o, d, {\n            pos: e.pos.scale(1 / 16),\n            p1: perp.scale(-1),\n            p2: perp.scale(1),\n        });\n        if (hit) {\n            hit.enemy = e;\n            objects.push(hit);\n        }\n    }\n    // Projectiles are billboarded the same way enemies are, just tagged\n    // with .projectile instead of .enemy so objects/player.js's draw() can\n    // tell the two apart and render them differently (see scenes/room2.js\n    // and objects/projectiles.js).\n    const projPerp = d.normal().unit().scale(0.15);\n    for (const proj of projectiles) {\n        if (proj.dead) continue;\n        const hit = raycastEdge(o, d, {\n            pos: proj.pos.scale(1 / 16),\n            p1: projPerp.scale(-1),\n            p2: projPerp.scale(1),\n        });\n        if (hit) {\n            hit.projectile = proj;\n            objects.push(hit);\n        }\n    }\n\n    const itemPerp = d.normal().unit().scale(0.10);\n    for (const it of items) {\n        if (it.collected) continue;\n        const hit2 = raycastEdge(o, d, {\n            pos: it.pos.scale(1 / 16),\n            p1: itemPerp.scale(-1),\n            p2: itemPerp.scale(1),\n        });\n        if (hit2) {\n            hit2.item = it;\n            objects.push(hit2);\n        }\n    }\n\n    if (wallHit) {\n        wallHit.point = wallHit.point.scale(16);\n        wallHit.object = { color: colors[grid[wallHit.gridPos.y][wallHit.gridPos.x]] };\n    }\n\n    const result = wallHit || { t: Infinity };\n    result.objects = objects;\n    return result;\n}\n","language":"javascript","path":"utils/raycast.js"}],["objects/projectiles.js",{"kind":"obj","value":"// Slow-moving projectiles fired by \"shooter\" enemies (see objects/enemies.js\n// and the purple square in scenes/room2.js). Plain data objects, same\n// pattern as objects/enemies.js, so utils/raycast.js can treat them as\n// billboards in the first-person view cheaply, plus each one gets a small\n// marker object so it shows up on the top-down debug view too.\n//\n// resetProjectiles() must be called once from inside a scene(...) callback\n// (same reasoning as spawnEnemies()/buildLevel() - add()'ing only works\n// once a scene is actually running, and this clears leftovers from a\n// previous run of the scene).\n\nimport k from \"../kaplay.js\";\nconst { vec2, add, pos, circle, color, z, anchor, destroy, dt } = k;\nimport { grid, isWallChar } from \"./objects/level.js\";\n\nexport const PROJECTILE_SPEED = 40; // slow-moving, world units/sec\nexport const PROJECTILE_RADIUS = 3;\nexport const PROJECTILE_DAMAGE = 15;\nconst PROJECTILE_MAX_RANGE = 400;\nconst PROJECTILE_COLOR = [160, 32, 240]; // purple, matches the shooter enemy\n\nexport let projectiles = [];\n\nexport function resetProjectiles() {\n    for (const p of projectiles) {\n        if (p.marker) destroy(p.marker);\n    }\n    projectiles = [];\n}\n\nfunction tileAt(x, y) {\n    if (y < 0 || y >= grid.length) return \"#\";\n    const row = grid[y];\n    if (x < 0 || x >= row.length) return \"#\";\n    return row[x];\n}\n\nfunction isWallAtPos(p) {\n    return isWallChar(tileAt(Math.floor(p.x / 16), Math.floor(p.y / 16)));\n}\n\n// Spawns one projectile at fromPos, travelling in a straight line toward\n// (the current position of) toPos. Called from objects/enemies.js's\n// updateEnemies() whenever a shooter enemy is ready to fire.\nexport function spawnProjectile(fromPos, toPos) {\n    const dir = toPos.sub(fromPos).unit();\n    const p = {\n        pos: fromPos.clone(),\n        dir,\n        dead: false,\n        traveled: 0,\n    };\n    p.marker = add([\n        pos(p.pos),\n        circle(PROJECTILE_RADIUS),\n        color(...PROJECTILE_COLOR),\n        z(1),\n        anchor(\"center\"),\n    ]);\n    projectiles.push(p);\n    return p;\n}\n\n// Ticked once per frame from the scene's onUpdate, mirroring\n// objects/enemies.js's updateEnemies(). Returns the total damage dealt to\n// the player this frame (0 if none) so the caller decides how to apply it.\nexport function updateProjectiles(playerPos) {\n    let damage = 0;\n\n    for (const p of projectiles) {\n        if (p.dead) continue;\n\n        const step = PROJECTILE_SPEED * dt();\n        p.pos = p.pos.add(p.dir.scale(step));\n        p.traveled += step;\n        p.marker.pos = p.pos;\n\n        if (isWallAtPos(p.pos) || p.traveled > PROJECTILE_MAX_RANGE) {\n            p.dead = true;\n            continue;\n        }\n\n        if (playerPos.sub(p.pos).len() <= 8) {\n            damage += PROJECTILE_DAMAGE;\n            p.dead = true;\n        }\n    }\n\n    const stillAlive = [];\n    for (const p of projectiles) {\n        if (p.dead) {\n            if (p.marker) destroy(p.marker);\n        } else {\n            stillAlive.push(p);\n        }\n    }\n    projectiles = stillAlive;\n\n    return damage;\n}\n","language":"javascript","path":"objects/projectiles.js"}],["scenes/room2.js",{"kind":"scene","value":"// A hand-built (non-procedural) room featuring a new enemy type: a\n// stationary purple \"shooter\" that fires slow-moving projectiles at the\n// player instead of chasing/melee-attacking it (see objects/enemies.js and\n// objects/projectiles.js). Reachable from the main game with \"n\" (see\n// scenes/game.js) - press \"b\" here to go back to the main maze.\n//\n// Mirrors scenes/game.js's structure (shoot/sword/movement/HUD all reuse\n// objects/player.js's createCamera() the same way), just with a small fixed\n// arena laid out by hand instead of a procedurally generated maze.\n\nimport k from \"../kaplay.js\";\nconst {\n    scene, go, Vec2, vec2, dt,\n    onKeyDown, onKeyPress, onUpdate, onTouchStart, onTouchMove,\n    onClick, onMousePress, onMouseDown,\n} = k;\nimport { buildLevel, grid, setCustomLevel, TILE } from \"../objects/level.js\";\nimport { spawnEnemies, updateEnemies, enemies, setEnemySpawns, ENEMY_SPAWNS } from \"../objects/enemies.js\";\nimport { resetProjectiles, updateProjectiles } from \"../objects/projectiles.js\";\nimport { setItemSpawns, spawnItems, updateItems } from \"../objects/items.js\";\nimport { createCamera } from \"../objects/player.js\";\nimport { rayCastAsciiGrid } from \"../utils/raycast.js\";\n\n// 16x11 fixed arena, walled on all sides. \"#\" is a wall tile, \" \" is floor\n// (same tile chars objects/level.js already understands).\nconst ROOM2_ROWS = [\n    \"################\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"#              #\",\n    \"################\",\n];\n\nscene(\"room2\", () => {\n    setCustomLevel(ROOM2_ROWS, vec2(TILE * 2 + TILE / 2, TILE * 5 + TILE / 2));\n    buildLevel();\n    setEnemySpawns([\n        { pos: vec2(TILE * 13 + TILE / 2, TILE * 5 + TILE / 2), kind: \"shooter\" },\n    ]);\n    spawnEnemies();\n    // The player starts the game with only the sword (see\n    // objects/player.js's createCamera()) - this chest is where the gun\n    // is actually picked up. See objects/items.js for how to add more.\n    setItemSpawns([\n        { pos: vec2(TILE * 8 + TILE / 2, TILE * 2 + TILE / 2), item: \"gun\" },\n    ]);\n    spawnItems();\n    resetProjectiles();\n    const camera = createCamera();\n\n    // ---- Gun (hitscan, same behavior as scenes/game.js) ----\n\n    function shoot() {\n        if (camera.currentWeapon !== \"gun\") return;\n        if (camera.shootCooldown > 0 || camera.gameOver || camera.score >= ENEMY_SPAWNS.length) {\n            return;\n        }\n        camera.shootCooldown = 0.35;\n        camera.muzzleFlash = 0.15;\n\n        const dir = Vec2.fromAngle(camera.angle).scale(16 * 20);\n        const result = rayCastAsciiGrid(camera.pos, dir, grid);\n\n        let closest = null;\n        for (const o of result.objects) {\n            if (!o.enemy) continue; // ignore projectile billboards\n            if (!closest || o.t < closest.t) closest = o;\n        }\n\n        if (closest && closest.t < result.t) {\n            const e = closest.enemy;\n            e.hp -= 40;\n            e.hitFlash = 0.15;\n            if (e.hp <= 0 && !e.dead) {\n                e.dead = true;\n                e.marker.opacity = 0.15;\n                camera.score++;\n            }\n        }\n    }\n\n    // ---- Sword (melee, same behavior as scenes/game.js) ----\n\n    const SWORD_RANGE = 40;\n    const SWORD_DAMAGE = 60;\n    const SWORD_CONE_DOT = 0.5;\n\n    function meleeAttack() {\n        if (camera.currentWeapon !== \"sword\" || camera.swordCooldown > 0 || camera.gameOver || camera.score >= ENEMY_SPAWNS.length) {\n            return;\n        }\n        camera.swordCooldown = 0.45;\n        camera.swordSwing = 0.2;\n\n        const facing = Vec2.fromAngle(camera.angle);\n        let target = null;\n        let targetDist = Infinity;\n\n        for (const e of enemies) {\n            if (e.dead) continue;\n            const toEnemy = e.pos.sub(camera.pos);\n            const dist = toEnemy.len();\n            if (dist > SWORD_RANGE) continue;\n            const facingDot = dist > 0 ? facing.dot(toEnemy.scale(1 / dist)) : 1;\n            if (facingDot < SWORD_CONE_DOT) continue;\n            if (dist < targetDist) {\n                targetDist = dist;\n                target = e;\n            }\n        }\n\n        if (target) {\n            target.hp -= SWORD_DAMAGE;\n            target.hitFlash = 0.15;\n            if (target.hp <= 0 && !target.dead) {\n                target.dead = true;\n                target.marker.opacity = 0.15;\n                camera.score++;\n            }\n        }\n    }\n\n    if (typeof onClick === \"function\") {\n        onClick(() => shoot());\n    } else if (typeof onMousePress === \"function\") {\n        onMousePress(() => shoot());\n    } else if (typeof onMouseDown === \"function\") {\n        onMouseDown(() => shoot());\n    }\n\n    onKeyPress(\"space\", () => shoot());\n    onKeyPress(\"e\", () => meleeAttack());\n    onKeyPress(\"enter\", () => {\n        if (camera.gameOver || camera.score >= ENEMY_SPAWNS.length) go(\"room2\");\n    });\n    onKeyPress(\"b\", () => go(\"game\")); // back to the main maze\n    onKeyPress(\"1\", () => { camera.currentWeapon = \"sword\"; }); // equip sword\n    onKeyPress(\"2\", () => { if (camera.weapons.gun) camera.currentWeapon = \"gun\"; }); // equip gun (if owned)\n\n    // ---- Movement (same scheme as scenes/game.js) ----\n\n    onKeyDown(\"w\", () => camera.move(Vec2.fromAngle(camera.angle).scale(40)));\n    onKeyDown(\"s\", () => camera.move(Vec2.fromAngle(camera.angle).scale(-40)));\n    onKeyDown(\"a\", () => camera.move(Vec2.fromAngle(camera.angle - 90).scale(40)));\n    onKeyDown(\"d\", () => camera.move(Vec2.fromAngle(camera.angle + 90).scale(40)));\n    onKeyDown(\"left\", () => { camera.angle -= 90 * dt(); });\n    onKeyDown(\"right\", () => { camera.angle += 90 * dt(); });\n\n    let lastTouchPos = vec2();\n    onTouchStart(p => { lastTouchPos = p; });\n    onTouchMove(p => {\n        const delta = p.sub(lastTouchPos);\n        if (delta.x < 0) camera.angle -= 90 * dt();\n        else if (delta.x > 0) camera.angle += 90 * dt();\n        if (delta.y < 0) camera.move(Vec2.fromAngle(camera.angle).scale(40));\n        else if (delta.y > 0) camera.move(Vec2.fromAngle(camera.angle).scale(-40));\n        lastTouchPos = p;\n    });\n\n    // ---- Per-frame timers + enemy/projectile updates ----\n\n    onUpdate(() => {\n        if (camera.shootCooldown > 0) camera.shootCooldown -= dt();\n        if (camera.muzzleFlash > 0) camera.muzzleFlash -= dt();\n        if (camera.swordCooldown > 0) camera.swordCooldown -= dt();\n        if (camera.swordSwing > 0) camera.swordSwing -= dt();\n        if (camera.pickupMessageTimer > 0) camera.pickupMessageTimer -= dt();\n        if (camera.gameOver) return;\n\n        const damage = updateEnemies(camera.pos);\n        if (damage > 0) {\n            camera.hp -= damage;\n            if (camera.hp <= 0) {\n                camera.hp = 0;\n                camera.gameOver = true;\n            }\n        }\n\n        updateItems(camera.pos, camera);\n        const projDamage = updateProjectiles(camera.pos);\n        if (projDamage > 0) {\n            camera.hp -= projDamage;\n            if (camera.hp <= 0) {\n                camera.hp = 0;\n                camera.gameOver = true;\n            }\n        }\n    });\n});\n","language":"javascript","path":"scenes/room2.js"}],["objects/items.js",{"kind":"obj","value":"// 6) Item / inventory / pickup system - imported by scenes/game.js and\n// scenes/room2.js (to place chests and tick pickups every frame) and by\n// utils/raycast.js + objects/player.js (so chests render as billboards\n// in the first-person view, the same trick objects/enemies.js and\n// objects/projectiles.js use).\n//\n// Items are plain data objects (not full KAPLAY entities), same pattern as\n// objects/enemies.js and objects/projectiles.js - each chest also gets a\n// small marker object added just so you can see it on the top-down debug\n// view in the background.\n//\n// spawnItems() must be called from inside a scene(...) callback (same\n// reasoning as spawnEnemies() in objects/enemies.js - add()'ing the marker\n// only works once a scene is actually running, and calling it again on\n// every scene (re)start is what clears leftover chests from the previous run).\n//\n// ---------------------------------------------------------------------------\n// HOW TO ADD A NEW ITEM / EQUIPMENT TYPE - step by step:\n//\n// 1. Add an entry to ITEM_TYPES below, keyed by a short id string, e.g.\n//\n//      shield: {\n//        label: \"shield\",\n//        color: [80, 160, 255],\n//        onPickup(camera) {\n//          camera.weapons.shield = true;\n//          camera.currentWeapon = \"shield\";\n//        },\n//      },\n//\n//    onPickup(camera) runs exactly once, the moment the player walks\n//    within PICKUP_RANGE of the chest - it's plain JS, so it can do\n//    anything: equip a weapon, heal the player (camera.hp = ...), add a\n//    key/currency counter, etc. It does not have to set `weapons` at all\n//    if the item isn't equippable (e.g. a one-off health potion, or the\n//    \"crystal\" floor-progress item below).\n//\n// 2. Place a chest holding it in any room by adding an entry to the list\n//    passed into setItemSpawns(...) inside that room's scene() callback:\n//\n//      setItemSpawns([\n//        { pos: vec2(TILE * 8 + TILE / 2, TILE * 2 + TILE / 2), item: \"shield\" },\n//      ]);\n//      spawnItems();\n//\n//    (see scenes/room2.js for a working example that places a \"gun\" chest).\n//\n// 3. If the new item is a weapon the player equips (like sword/gun), also:\n//    a) give it a default `false` entry in the `weapons` object inside\n//       objects/player.js's createCamera(), so `1`/`2`/etc. key checks\n//       like `if (camera.weapons.gun)` work before it's been picked up.\n//    b) add an onKeyPress(...) in the room's scene() to switch to it,\n//       guarded by that same `camera.weapons.<id>` check.\n//\n// That's it. spawnItems(), updateItems(), the raycaster (utils/raycast.js)\n// and the HUD (objects/player.js) all loop over ITEM_TYPES/ITEM_SPAWNS by\n// id - nothing else needs to change to support a brand new item.\n// ---------------------------------------------------------------------------\n\nimport k from \"../kaplay.js\";\nconst { add, pos, rect, color, z, anchor, destroy } = k;\nimport { collectCrystal } from \"./objects/progress.js\";\n\n// How close (world units) the player needs to walk to a chest to auto-pick\n// it up. Tiles are 16 units (see objects/level.js's TILE), so this is a\n// little under one tile.\nconst PICKUP_RANGE = 14;\n\n// The registry every chest reads from - add new items here (see the guide\n// above). Everything else in this file works off ids, never hardcoded item\n// names, so this is the only place a new item needs to be *defined*.\nexport const ITEM_TYPES = {\n\n    gun: {\n        label: \"gun\",\n        color: [255, 210, 60],\n        onPickup(camera) {\n            camera.weapons.gun = true;\n            camera.currentWeapon = \"gun\";\n        },\n    },\n    // Floor-progress goal - placed by objects/level.js's generateLevel()\n    // (see its crystalSpawns) and CRYSTALS_PER_FLOOR of these have to be\n    // collected to complete a floor (see objects/progress.js's\n    // collectCrystal(), and scenes/game.js's onUpdate which watches\n    // camera.floorComplete).\n    crystal: {\n        label: \"crystal\",\n        color: [80, 220, 255],\n        onPickup(camera) {\n            const floorDone = collectCrystal();\n            if (floorDone) camera.floorComplete = true;\n        },\n    },\n};\n\n// `ITEM_SPAWNS` is the input (set once per scene start, see setItemSpawns()\n// calls in scenes/game.js and scenes/room2.js), `items` is the live state\n// spawnItems() builds from it - same split as ENEMY_SPAWNS/enemies in\n// objects/enemies.js.\nexport let ITEM_SPAWNS = [];\nexport function setItemSpawns(list) {\n    ITEM_SPAWNS = list;\n}\n\nexport let items = [];\n\nexport function spawnItems() {\n    for (const it of items) {\n        if (it.marker) destroy(it.marker);\n    }\n    items = ITEM_SPAWNS.map((spawnEntry) => {\n        const type = ITEM_TYPES[spawnEntry.item];\n        const it = {\n            pos: spawnEntry.pos.clone(),\n            item: spawnEntry.item,\n            collected: false,\n        };\n        it.marker = add([\n            pos(it.pos),\n            rect(6, 6),\n            color(...(type ? type.color : [255, 255, 255])),\n            z(1),\n            anchor(\"center\"),\n        ]);\n        return it;\n    });\n}\n\n// Ticked once per frame from the scene's onUpdate, right next to\n// updateEnemies()/updateProjectiles() (see scenes/game.js and\n// scenes/room2.js). Walking within PICKUP_RANGE of an uncollected chest\n// picks it up automatically - no keypress needed - and fires its\n// onPickup(camera). Also sets camera.pickupMessage/pickupMessageTimer so\n// the HUD (objects/player.js) can flash what was just picked up.\nexport function updateItems(playerPos, camera) {\n    for (const it of items) {\n        if (it.collected) continue;\n        const dist = it.pos.sub(playerPos).len();\n        if (dist <= PICKUP_RANGE) {\n            it.collected = true;\n            if (it.marker) destroy(it.marker);\n            const type = ITEM_TYPES[it.item];\n            if (type) {\n                type.onPickup(camera);\n                camera.pickupMessage = `Picked up ${type.label}!`;\n                camera.pickupMessageTimer = 2;\n            }\n        }\n    }\n}\n","language":"javascript","path":"objects/items.js"}],["objects/progress.js",{"kind":"obj","value":"// Cross-scene run state: floor progress, crystal collection, and the\n// weapons/HP that persist between go(\"game\") calls when advancing floors.\n// Everything here is plain exported state + small setter/mutator functions,\n// same \"let export + explicit setter\" pattern used by objects/level.js and\n// objects/enemies.js, so ES module \"live bindings\" keep every importer\n// (objects/player.js, scenes/game.js, objects/items.js) automatically in\n// sync with the current values.\n\nexport const MAX_FLOORS = 3;\nexport const CRYSTALS_PER_FLOOR = 3;\n\nexport let currentFloor = 1;\nexport let crystalsCollected = 0;\nexport let won = false;\n\nexport let persistentWeapons = { sword: true, gun: false };\nexport let persistentHp = 100;\n\nexport function setPersistentHp(hp) {\n    persistentHp = hp;\n}\n\n// Called by objects/items.js's \"crystal\" ITEM_TYPES entry when a crystal\n// chest is picked up. Returns true once enough crystals have been\n// collected to complete the current floor - scenes/game.js watches\n// camera.floorComplete (set by items.js when this returns true) in its\n// onUpdate to advance to the next floor.\nexport function collectCrystal() {\n    crystalsCollected++;\n    return crystalsCollected >= CRYSTALS_PER_FLOOR;\n}\n\n// Moves on to the next floor - resets the crystal count and flags `won`\n// once every floor has been cleared (see scenes/game.js's onUpdate).\nexport function advanceFloor() {\n    currentFloor++;\n    crystalsCollected = 0;\n    if (currentFloor > MAX_FLOORS) {\n        won = true;\n    }\n}\n\n// Resets the whole run back to floor 1 - called from scenes/game.js's\n// \"enter\" handler when the player restarts after game over or after\n// winning.\nexport function resetRun() {\n    currentFloor = 1;\n    crystalsCollected = 0;\n    won = false;\n    persistentWeapons = { sword: true, gun: false };\n    persistentHp = 100;\n}\n","language":"javascript","path":"objects/progress.js"}],["scenes/title.js",{"kind":"scene","value":"import k from \"../kaplay.js\";\nconst {\n    scene, onUpdate, setCursor, add, rect, pos, area, scale, anchor,\n    outline, color, text, time, hsl2rgb, vec2, go, rgb, width, height, z,\n} = k;\n\nscene(\"title\", () => {\n    // reset cursor to default on frame start for easier cursor management\n    onUpdate(() => setCursor(\"default\"));\n\n    // ---- Big title banner: \"Doom 90\" ----\n    const bannerHeight = 160;\n    add([\n        rect(width(), bannerHeight),\n        pos(0, 0),\n        color(20, 20, 20),\n        z(0),\n    ]);\n    add([\n        rect(width(), 6),\n        pos(0, bannerHeight - 6),\n        color(180, 30, 30),\n        z(0),\n    ]);\n    add([\n        text(\"Doom 90\", { size: 84 }),\n        pos(width() / 2, bannerHeight / 2),\n        anchor(\"center\"),\n        color(200, 40, 40),\n        outline(8, rgb(0, 0, 0)),\n        z(1),\n    ]);\n\n    // Function that adds a button to the game with a given text, position and function\n    function addButton(\n        txt = \"start game\",\n        p = vec2(200, 100),\n        f = () => debug.log(\"hello\"),\n    ) {\n        // add a parent background object\n        const btn = add([\n            rect(240, 80, { radius: 8 }),\n            pos(p),\n            area(),\n            scale(1),\n            anchor(\"center\"),\n            outline(4),\n            color(255, 255, 255),\n        ]);\n\n        // add a child object that displays the text\n        btn.add([\n            text(txt),\n            anchor(\"center\"),\n            color(0, 0, 0),\n        ]);\n\n        // onHoverUpdate() comes from area() component\n        // it runs every frame when the object is being hovered\n        btn.onHoverUpdate(() => {\n            const t = time() * 10;\n            btn.color = hsl2rgb((t / 10) % 1, 0.6, 0.7);\n            btn.scale = vec2(1.2);\n            setCursor(\"pointer\");\n        });\n\n        // onHoverEnd() comes from area() component\n        // it runs once when the object stopped being hovered\n        btn.onHoverEnd(() => {\n            btn.scale = vec2(1);\n            btn.color = rgb();\n        });\n\n        // onClick() comes from area() component\n        // it runs once when the object is clicked\n        btn.onClick(f);\n\n        return btn;\n    }\n\n    // Buttons are centered horizontally on screen, and stacked vertically\n    // centered in the space below the title banner.\n    const centerX = width() / 2;\n    const contentCenterY = bannerHeight + (height() - bannerHeight) / 2;\n\n    addButton(\"Start\", vec2(centerX, contentCenterY - 60), () => go(\"game\"));\n    addButton(\"Quit\", vec2(centerX, contentCenterY + 60), () => go(\"options\"));\n});\n","language":"javascript","path":"scenes/title.js"}],["scenes/options.js",{"kind":"scene","value":"import k from \"../kaplay.js\";\nconst {\n    scene, onUpdate, setCursor, add, rect, pos, area, scale, anchor,\n    outline, color, text, time, hsl2rgb, vec2, go, rgb, width, height,\n} = k;\n\n// Minimal options/quit screen, reached from the title screen's \"Quit\"\n// button (see scenes/title.js). Just a \"Back\" button for now - add real\n// settings here (volume, difficulty, etc.) the same way scenes/title.js\n// adds buttons.\nscene(\"options\", () => {\n    onUpdate(() => setCursor(\"default\"));\n\n    add([\n        text(\"Options\", { size: 48 }),\n        pos(width() / 2, height() / 2 - 140),\n        anchor(\"center\"),\n        color(255, 255, 255),\n    ]);\n\n    add([\n        text(\"Nothing to configure yet.\", { size: 20 }),\n        pos(width() / 2, height() / 2 - 70),\n        anchor(\"center\"),\n        color(200, 200, 200),\n    ]);\n\n    const btn = add([\n        rect(200, 70, { radius: 8 }),\n        pos(width() / 2, height() / 2 + 40),\n        area(),\n        scale(1),\n        anchor(\"center\"),\n        outline(4),\n        color(255, 255, 255),\n    ]);\n\n    btn.add([\n        text(\"Back\"),\n        anchor(\"center\"),\n        color(0, 0, 0),\n    ]);\n\n    btn.onHoverUpdate(() => {\n        const t = time() * 10;\n        btn.color = hsl2rgb((t / 10) % 1, 0.6, 0.7);\n        btn.scale = vec2(1.1);\n        setCursor(\"pointer\");\n    });\n\n    btn.onHoverEnd(() => {\n        btn.scale = vec2(1);\n        btn.color = rgb();\n    });\n\n    btn.onClick(() => go(\"title\"));\n});\n","language":"javascript","path":"scenes/options.js"}]],"assets":[["assets/sprites/mark.png",{"name":"mark.png","path":"assets/sprites/mark.png","url":"data:image/png;base64,","kind":"sprite","importFunction":"loadSprite(\"mark\", \"assets/sprites/mark.png\");"}],["assets/sounds/mark_voice.wav",{"name":"mark_voice.wav","path":"assets/sounds/mark_voice.wav","url":"data:audio/wave;base64,","kind":"sound","importFunction":"loadSound(\"mark_voice\", \"assets/sounds/mark_voice.wav\");"}],["assets/sprites/wall.png",{"name":"wall.png","kind":"sprite","path":"assets/sprites/wall.png","url":"data:image/png;base64,","importFunction":"loadSprite(\"wall\", \"assets/sprites/wall.png\");"}]],"mode":"pj","buildMode":"esbuild","kaplayVersion":"4000.0.0-alpha.27.1","createdAt":"2026-07-03T12:36:59.660Z","updatedAt":"2026-07-07T00:23:56.594Z","favicon":"","id":"019f27fb-788c-7bcb-9b37-fb843b8fa249"}